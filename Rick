local function mk(class, props, parent)
    local o = Instance.new(class)
    if props then for k, v in pairs(props) do o[k] = v end end
    if parent then o.Parent = parent end
    return o
end
local function corner(r, p) return mk("UICorner", { CornerRadius = UDim.new(0, r) }, p) end
local function addStroke(c, th, tr, p)
    return mk("UIStroke", {
        Color = c, Thickness = th or 1, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, p)
end
local function tw(o, t, props)
    local tn = TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tn:Play()
    return tn
end
local function hover(b, base, hov, press)
    b.MouseEnter:Connect(function() tw(b, 0.12, { BackgroundColor3 = hov }) end)
    b.MouseLeave:Connect(function() tw(b, 0.15, { BackgroundColor3 = base }) end)
    if press then
        b.MouseButton1Down:Connect(function() tw(b, 0.06, { BackgroundColor3 = press }) end)
        b.MouseButton1Up:Connect(function() tw(b, 0.12, { BackgroundColor3 = hov }) end)
    end
end

