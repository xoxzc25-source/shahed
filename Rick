        dots[i] = {
            h = holder, halo = halo, core = core,
            cx = math.random(), cy = math.random(),
            rx = 0.03 + math.random() * 0.06, ry = 0.03 + math.random() * 0.06,
            sa = 0.1 + math.random() * 0.25, sb = 0.1 + math.random() * 0.25,
            pa = math.random() * 6.28, pb = math.random() * 6.28,
            fl = 0.4 + math.random() * 0.9,
        }
    end
    bind(RunService.RenderStepped:Connect(function()
        if not (win and win.Visible) then return end
        local t = os.clock()
        for _, d in ipairs(dots) do
            local px = d.cx + math.sin(t * d.sa + d.pa) * d.rx
            local py = d.cy + math.cos(t * d.sb + d.pb) * d.ry
            d.h.Position = UDim2.new(px, 0, py, 0)
            local pulse = 0.5 + 0.5 * math.sin(t * d.fl + d.pa)
            d.halo.BackgroundTransparency = 0.93 - 0.1 * pulse
            d.halo.Size = UDim2.fromOffset(8 + pulse * 5, 8 + pulse * 5)
            d.core.BackgroundTransparency = 0.45 - 0.35 * pulse
        end
    end))

    end

    renderType()
end

