            BorderSizePixel = 0, BackgroundColor3 = T.white, AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.fromOffset((i - 1) * 4, 12), Size = UDim2.fromOffset(2, 2 + (i - 1) * 3),
        }, net)
    end
    hudUI.ping = mk("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X,
        Font = Enum.Font.Code, Text = "-- ms", TextColor3 = T.hudtxt, TextSize = 12, LayoutOrder = 6,
    }, bar)
    sepF(7)
    hudUI.fps = mk("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X,
        Font = Enum.Font.Code, Text = "-- FPS", TextColor3 = T.hudtxt, TextSize = 12, LayoutOrder = 8,
    }, bar)
    sepF(9)
    hudUI.time = mk("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X,
        Font = Enum.Font.Code, Text = "--:--", TextColor3 = T.hudtxt, TextSize = 12, LayoutOrder = 10,
    }, bar)
    end

    tooltip = mk("TextLabel", {
        Position = UDim2.fromOffset(0, 42),
        Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X,
        BackgroundColor3 = T.bg, BorderSizePixel = 0,
        Font = Enum.Font.Code, Text = "  НАЖМИ, ЧТОБЫ ОТКРЫТЬ МЕНЮ  ",
        TextColor3 = Color3.fromRGB(200, 200, 200), TextSize = 11, Visible = false,
        ZIndex = 5,
    }, hudWrap)
    corner(6, tooltip)
    addStroke(T.stroke, 1, 0.3, tooltip)

    bar.MouseButton1Click:Connect(function() toggleWindow() end)

    bar.MouseEnter:Connect(function()
        hudStroke.Color = T.white
        hudStroke.Transparency = 0
        hudStroke.Thickness = 2
        showTooltip()
    end)
    bar.MouseLeave:Connect(function()
        hudStroke.Color = T.stroke
        hudStroke.Transparency = 0.25
        hudStroke.Thickness = 1
        hideTooltip()
    end)

    local dragging, dStart, dPos = false, nil, nil
    bar.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging, dStart, dPos = true, inp.Position, hudWrap.Position
        end
    end)
    bind(UserInputService.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            local d = inp.Position - dStart
            hudWrap.Position = dPos + UDim2.fromOffset(d.X, d.Y)
        end
    end))
    bind(UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

