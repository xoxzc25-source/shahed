local SoundService = game:GetService("SoundService")
local soundCache = {}
local function pickSound(key)
    if soundCache[key] ~= nil then return soundCache[key] end
    local list = soundIds[key]
    if not list then return nil end
    for _, id in ipairs(list) do
        local path = (type(id) == "number") and ("rbxassetid://" .. id) or tostring(id)
        local s = Instance.new("Sound")
        s.SoundId = path
        s.Volume = 0
        s.Parent = SoundService
        local fetched = false
        local ok = pcall(function()
            ContentProvider:PreloadAsync({ s }, function(_, st)
                if st == Enum.AssetFetchStatus.Success then fetched = true end
            end)
        end)
        local good = ok and (fetched or s.IsLoaded or s.TimeLength > 0)
        s:Destroy()
        if good then
            soundCache[key] = path
            return path
        end
    end
    warn("[ШАХЕД HUB] звук '" .. key .. "': ни один ID не загрузился, играет встроенный")
    soundCache[key] = false
    return nil
end

