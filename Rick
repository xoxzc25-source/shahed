            rsp = rsp + 0.9
            if isFpvReplay then
                updateFpvFX(replayFX, cf, rsp)
            else
                for _, pr in ipairs(replayProps) do
                    if pr.p.Parent then
                        local sp
                        if pr.axisRel then
                            sp = pr.rel.Rotation * CFrame.fromAxisAngle(pr.axisRel, rsp)
