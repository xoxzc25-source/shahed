local function makeDroneModel(tp)
    local m = nil
    local isFallback = false

    if not forceFallback[tp] then
        m = getRawModel(tp)
    end
    if m and countOpaque(m) == 0 then
        m:Destroy()
        m = nil
    end
    if m then
        local minV, maxV = opaqueBounds(m)
        local bad = true
        if minV then
            local e = maxV - minV
            local mx = math.max(e.X, e.Y, e.Z)
            bad = not (mx > 0.05 and mx < 2000)
        end
        if bad then
            m:Destroy()
            m = nil
        end
    end
    if not m then
        m = (tp == "fpv") and buildFpvFallback() or buildShahedFallback()
        isFallback = true
    end

    scaleToSize(m, tp == "fpv" and 7 or 12)
    if not isFallback then
        applyRotation(m, droneRot[tp])
    end
    finalizePivot(m)
    return m
end

--═══ ВИНТЫ ШАХЕДА — v5.2 БЕЗ ИЗМЕНЕНИЙ ═══
local function collectPropLocals(m, isFpv, pivotCF)
    local locals = {}

    -- 1) по имени
    for _, x in ipairs(m:GetDescendants()) do
        if x:IsA("BasePart") then
            local n = x.Name:lower()
            if n:find("prop") or n:find("blade") or n:find("rotor")
                or n:find("винт") or n:find("лопаст") or n:find("fan") then
                locals[#locals + 1] = {
                    p = x,
                    rel = pivotCF:ToObjectSpace(x.CFrame),
                    ax = isFpv and "y" or "z",
                }
            end
        end
    end
    if #locals > 0 then return locals end

    -- 2) авто-поиск: плоские детали-лопасти выше центра, дальше 18% габарита
    local ok, bbCF, bbSize = pcall(function() return m:GetBoundingBox() end)
    if not ok or not bbCF then return locals end
    local c = bbCF.Position
    local ext = math.max(bbSize.X, bbSize.Y, bbSize.Z)

    local biggest, bigVol = nil, 0
    for _, x in ipairs(m:GetDescendants()) do
        if x:IsA("BasePart") and x.Transparency < 1 then
            local v = x.Size.X * x.Size.Y * x.Size.Z
            if v > bigVol then bigVol = v biggest = x end
        end
    end

    local cands = {}
    for _, x in ipairs(m:GetDescendants()) do
        if x:IsA("BasePart") and x.Transparency < 1 and x ~= biggest then
            local dims = { x.Size.X, x.Size.Y, x.Size.Z }
            table.sort(dims)
            local isFlat = dims[1] < dims[3] * 0.4
            local aboveCenter = x.Position.Y >= c.Y - ext * 0.08
            local flatDist = (Vector3.new(x.Position.X, 0, x.Position.Z)
                - Vector3.new(c.X, 0, c.Z)).Magnitude
            if isFlat and aboveCenter and flatDist > ext * 0.18 then
                cands[#cands + 1] = { p = x, d = flatDist }
            end
        end
    end
    table.sort(cands, function(a, b) return a.d > b.d end)

    for i = 1, math.min(#cands, 4) do
        local part = cands[i].p
        local rel = pivotCF:ToObjectSpace(part.CFrame)
        local dims = { part.Size.X, part.Size.Y, part.Size.Z }
        local axisLocal
        if dims[1] <= dims[2] and dims[1] <= dims[3] then
            axisLocal = Vector3.xAxis
        elseif dims[2] <= dims[3] then
            axisLocal = Vector3.yAxis
        else
            axisLocal = Vector3.zAxis
        end
        locals[#locals + 1] = {
            p = part,
            rel = rel,
            axisRel = axisLocal,
        }
    end
    return locals
end

