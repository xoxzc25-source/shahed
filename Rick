                local v = math.random(30, 100) / 100
                s.BackgroundColor3 = Color3.new(v, v, v)
            end
            repLbl.Visible = math.floor((os.clock() - st) * 8) % 2 == 0
            RunService.RenderStepped:Wait()
        end
        tw(win2, 0.35, { GroupTransparency = 1 })
        task.wait(0.4)
        gui:Destroy()
    end)
