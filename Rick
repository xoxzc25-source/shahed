local rawCache = {}

local function anyPart(m)
    if not m then return nil end
    return m:FindFirstChildWhichIsA("BasePart", true)
end

local function sanitizeModel(m)
    for _, x in ipairs(m:GetDescendants()) do
        if x:IsA("BasePart") then
            x.Anchored, x.CanCollide, x.CanQuery, x.CanTouch = true, false, false, false
        elseif x:IsA("Script") or x:IsA("LocalScript") then
            x.Disabled = true
        elseif x:IsA("Sound") or x:IsA("ClickDetector") or x:IsA("ProximityPrompt")
            or x:IsA("Humanoid") or x:IsA("BillboardGui") then
            x:Destroy()
        end
    end
    return m
end

local function countOpaque(m)
    local n = 0
    for _, p in ipairs(m:GetDescendants()) do
        if p:IsA("BasePart") and p.Transparency < 1 then n += 1 end
    end
    return n
end

local function opaqueBounds(m)
    local minV, maxV
    for _, p in ipairs(m:GetDescendants()) do
        if p:IsA("BasePart") and p.Transparency < 1 then
            local cf, s = p.CFrame, p.Size
            for ox = -1, 1, 2 do
                for oy = -1, 1, 2 do
                    for oz = -1, 1, 2 do
                        local cp = (cf * CFrame.new(s.X * 0.5 * ox, s.Y * 0.5 * oy, s.Z * 0.5 * oz)).Position
                        minV = minV and minV:Min(cp) or cp
                        maxV = maxV and maxV:Max(cp) or cp
                    end
                end
            end
        end
    end
    if not minV then return nil end
    return minV, maxV
end

local function scaleToSize(m, target)
    local minV, maxV = opaqueBounds(m)
    if not minV then return m end
    local ext = math.max(maxV.X - minV.X, maxV.Y - minV.Y, maxV.Z - minV.Z)
    if ext < 0.05 then return m end
    pcall(function() m:ScaleTo(target / ext) end)
    return m
end

local function applyRotation(m, rot)
    if not rot or (rot.x == 0 and rot.y == 0 and rot.z == 0) then return end
    local ok = pcall(function()
        local c = m:GetBoundingBox().Position
        local rX = CFrame.fromEulerAnglesYXZ(math.rad(rot.x), 0, 0)
        local rY = CFrame.fromEulerAnglesYXZ(0, math.rad(rot.y), 0)
        local rZ = CFrame.fromEulerAnglesYXZ(0, 0, math.rad(rot.z))
        local R = rZ * rY * rX
        local world = CFrame.new(c) * R * CFrame.new(-c)
        for _, p in ipairs(m:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CFrame = world * p.CFrame
            end
        end
    end)
    if not ok then warn("[ШАХЕД HUB] разворот модели не удался") end
end

local function finalizePivot(m)
    m.PrimaryPart = nil
    local ok, cf = pcall(function() return m:GetBoundingBox() end)
    if ok and cf then
        m.WorldPivot = CFrame.new(cf.Position)
    end
end

local rawFailed = {}

local function meshesLoadOk(m)
    local nums, insts = {}, {}
    for _, d in ipairs(m:GetDescendants()) do
        if d:IsA("MeshPart") or d:IsA("SpecialMesh") then
            local mid = tostring(d.MeshId or "")
            if mid ~= "" then
                insts[#insts + 1] = d
                local num = mid:match("%d+")
                if num then nums[#nums + 1] = num end
            end
        end
    end
    if #insts == 0 then return true end
    local ok = true
    pcall(function()
        ContentProvider:PreloadAsync(insts, function(cid, status)
            if status ~= Enum.AssetFetchStatus.Success then
                for _, num in ipairs(nums) do
                    if string.find(tostring(cid), num, 1, true) then
                        ok = false
                        break
                    end
                end
            end
        end)
    end)
    return ok
end

local function getRawModel(tp)
    if rawCache[tp] then return rawCache[tp]:Clone() end
    if rawFailed[tp] then return nil end
    local stored = ReplicatedStorage:FindFirstChild((tp == "fpv") and "FpvModel" or "ShahedModel")
    if stored then
        local sm = Instance.new("Model")
        if stored:IsA("Model") or stored:IsA("Folder") then
            for _, ch in ipairs(stored:GetChildren()) do
                local c = ch:Clone()
                if c then c.Parent = sm end
            end
        else
            local c = stored:Clone()
            if c then c.Parent = sm end
        end
        if sm:FindFirstChildWhichIsA("BasePart", true) then
            sanitizeModel(sm)
            rawCache[tp] = sm
            return sm:Clone()
        end
        sm:Destroy()
    end
    local ids = (tp == "fpv") and fpvIds or shahedIds
    for _, id in ipairs(ids) do
        local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
        if ok and objs and #objs > 0 then
            local m = Instance.new("Model")
            for _, o in ipairs(objs) do o.Parent = m end
            if m:FindFirstChildWhichIsA("BasePart", true) then
                sanitizeModel(m)
                if meshesLoadOk(m) then
                    rawCache[tp] = m
                    return m:Clone()
                end
            end
            m:Destroy()
        end
    end
    rawFailed[tp] = true
    warn("[ШАХЕД HUB] ни одна модель " .. tp .. " не загрузилась — запасная")
    return nil
end

