local pushBusy = false
local function pushFling(targetPlayer)
    if pushBusy then return end
    local char = getChar()
    local hum, r = getHum(), getRoot()
    local tChar = targetPlayer.Character
    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
    local tPart = tChar and (tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("Head"))
    if not (char and hum and r and hum.Health > 0 and tHum and tPart and tHum.Health > 0) then return end
    if tHum.Sit then return end
    pushBusy = true

    pcall(function()
        sethiddenproperty(player, "SimulationRadius", math.huge)
    end)

    local savedPivot = char:GetPivot()
    local savedAutoRotate = hum.AutoRotate
    local savedFallen = workspace.FallenPartsDestroyHeight

    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.zero
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Parent = r
    hum.AutoRotate = false
    local fallenDisabled = pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end)

    local origin = tPart.Position
    local started = os.clock()
    local launched = false
    local function escaped()
        if not tPart.Parent then return true end
        local d = (tPart.Position - origin).Magnitude
        local s = tPart.AssemblyLinearVelocity.Magnitude
        return d > 350 or (d > 120 and s > 200)
    end

    local angle = 0
    while os.clock() - started < 2 and not launched do
        if not (r.Parent and hum.Health > 0 and tPart.Parent and tHum.Health > 0) then break end
        if escaped() then launched = true break end
        angle += 100
        local rot = CFrame.Angles(math.rad(angle), 0, 0)
        local speed = tPart.AssemblyLinearVelocity.Magnitude
        local steps
        if speed < 50 then
            local lead = tHum.MoveDirection * speed / 1.25
            steps = {
                CFrame.new(0, 1.5, 0) + lead, CFrame.new(0, -1.5, 0) + lead,
                CFrame.new(0, 1.5, 0) + lead, CFrame.new(0, -1.5, 0) + lead,
                CFrame.new(0, 1.5, 0) + tHum.MoveDirection,
                CFrame.new(0, -1.5, 0) + tHum.MoveDirection,
            }
        else
            local q = CFrame.Angles(math.rad(90), 0, 0)
            steps = {
                CFrame.new(0, 1.5, tHum.WalkSpeed) * q, CFrame.new(0, -1.5, -tHum.WalkSpeed),
                CFrame.new(0, 1.5, tHum.WalkSpeed) * q, CFrame.new(0, -1.5, 0) * q,
                CFrame.new(0, -1.5, 0), CFrame.new(0, -1.5, 0) * q,
                CFrame.new(0, -1.5, 0),
            }
        end
        for _, off in ipairs(steps) do
            local cf = CFrame.new(tPart.Position) * off * rot
            r.CFrame = cf
            char:PivotTo(cf)
            r.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
            r.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)
            task.wait()
            if escaped() then launched = true break end
        end
    end

    bv:Destroy()
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
    if r.Parent and hum.Health > 0 then
        for _ = 1, 6 do
            char:PivotTo(savedPivot * CFrame.new(0, 0.5, 0))
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.AssemblyLinearVelocity = Vector3.zero
                    p.AssemblyAngularVelocity = Vector3.zero
                end
            end
            if (r.Position - savedPivot.Position).Magnitude < 25 then break end
            RunService.Heartbeat:Wait()
        end
        hum.AutoRotate = savedAutoRotate
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    if fallenDisabled then pcall(function() workspace.FallenPartsDestroyHeight = savedFallen end) end
    pushBusy = false
end

