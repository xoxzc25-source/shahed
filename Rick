local function endFlight(explode)
    if not flying then return end
    flying = false
    setTouchVisible(false)
    pcall(function() RunService:UnbindFromRenderStep(CAM_BIND) end)
    if hintLbl then hintLbl.Visible = false end
    if osd then osd.Visible = false end
    local pos = dronePos
    local target, bd = nil, CONFIG.DRONE_BLAST
    if pos then
        for _, o in ipairs(Players:GetPlayers()) do
            if o ~= player and o.Character then
                local hr = o.Character:FindFirstChild("HumanoidRootPart")
                local hu = o.Character:FindFirstChildOfClass("Humanoid")
                if hr and hu and hu.Health > 0 then
                    local d = (hr.Position - pos).Magnitude
                    if d < bd then target, bd = o, d end
                end
            end
        end
    end
    local impact = nil
    if explode and pos then impact = findImpact(pos, droneModel) end
    if droneModel then droneModel:Destroy() droneModel = nil end
    if engineSound then pcall(function() engineSound:Stop() engineSound:Destroy() end) end
    engineSound = nil
    droneParts = {}
    fpApplied = false
    local hum = getHum()
    if hum then hum.WalkSpeed, hum.JumpPower = savedWS or 16, savedJP or 50 end
    pcall(function() controls:Enable() end)
    -- снять якорь с персонажа
    local rr = getRoot()
    if rr then rr.Anchored = false end
    hideChar(false)
    local cam = workspace.CurrentCamera
    if cam then cam.CameraType = Enum.CameraType.Custom end
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    -- ФИКС: страховка от залипания мыши в центре после шифт-лока
    task.spawn(function()
        for _ = 1, 40 do
            if flying then break end -- дрон снова запущен — не мешаем
            if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                RunService.RenderStepped:Wait()
                -- если залочился обратно — шифт-лок включён в настройках, не трогаем
                if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then break end
            else
                break
            end
            RunService.RenderStepped:Wait()
        end
    end)

    if explode and pos then
        flashWhite()
        explosionFX(pos, droneType)
        makeCrater(impact, droneType)

        local dronePathCopy = {}
        for i, v in ipairs(recBuf) do dronePathCopy[i] = v end
        local targetPathCopy
        if target and recPlayers[target] then
            targetPathCopy = {}
            for i, v in ipairs(recPlayers[target]) do targetPathCopy[i] = v end
        end

        if target then
            local remote = ReplicatedStorage:FindFirstChild(CONFIG.FLING_REMOTE)
            local staticDur
            if remote then
                remote:FireServer(target)
                setStatus("FLING > " .. target.DisplayName)
                staticDur = 1.8
            else
                setStatus("PUSH > " .. target.DisplayName)
                task.spawn(pushFling, target)
                staticDur = 2.7
            end
            staticNO(staticDur)
            task.delay(staticDur + 0.2, function()
                showReplay(pos, target, dronePathCopy, targetPathCopy, impact)
            end)
        else
            staticNO(0.8)
            setStatus("целей рядом не было")
        end

        setButtons(false, false, false)
        task.delay(6.5, function()
            if not flying then setStatus("READY") setButtons(true, false, false) end
        end)
    else
        setStatus("READY")
        setButtons(true, false, false)
    end
    if toggleWindow and not IS_MOBILE then toggleWindow(true) end
end

