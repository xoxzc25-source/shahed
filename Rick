                    end
                end
            end
            recD.Visible = (os.clock() % 0.8) < 0.5
            lineFill.Size = UDim2.new(math.min(e / playDur, 1), 0, 1, 0)
            if not boomed and e >= playDur - 0.08 then
                boomed = true
                fire2:Emit(70)
                smoke2:Emit(40)
                repStatic.Visible = true
            end
            if repStatic.Visible then
                for _, s in ipairs(repStrips) do
                    local w = math.random(10, 100) / 100
                    local h = math.random(1, 3) / 100
                    s.Size = UDim2.fromScale(w, h)
                    s.Position = UDim2.fromScale(math.random() * (1 - w), math.random() * (1 - h))
                    local v = math.random(30, 100) / 100
                    s.BackgroundColor3 = Color3.new(v, v, v)
                end
                repLbl.Visible = math.floor((os.clock() - start) * 8) % 2 == 0
            end
            RunService.RenderStepped:Wait()
        end
        -- помехи 1.0с и окно тает вместе с ними
        local st = os.clock()
        while os.clock() - st < 1.0 do
            for _, s in ipairs(repStrips) do
