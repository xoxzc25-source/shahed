    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local ign = {}
    if ignoreModel then ign[#ign + 1] = ignoreModel end
    for _, o in ipairs(Players:GetPlayers()) do
