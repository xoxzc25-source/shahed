    if input.KeyCode == Enum.KeyCode.M then
        if not flying then toggleWindow() end
    elseif flying and input.KeyCode == Enum.KeyCode.X then
        endFlight(false)
    elseif flying and input.KeyCode == Enum.KeyCode.V then
        firstPerson = not firstPerson
    elseif flying and input.UserInputType == Enum.UserInputType.MouseButton1
        and os.clock() - flightStart > CONFIG.DRONE_MIN then
        endFlight(true)
    end
end))

