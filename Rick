        local start = os.clock()
        local boomed = false
        local rsp = 0
        while true do
            local e = os.clock() - start
            if e >= playDur then break end
            local tt = t0 + e * 0.85
            local cf = samplePath(dronePath, tt)
            if cf then droneClone:PivotTo(cf) end
            if charClone and targetPath then
