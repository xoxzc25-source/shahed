-- Настоящие лопасти НЕ КРУТЯТСЯ. Определяем только ЦЕНТРЫ втулок
-- (из реальных позиций лопастей) и радиус. Детали-эффекты создаём
-- сами и вращаем строго вокруг вертикали дрона.
local function collectFpvHubs(m, pivotCF)
    local found = {}

    -- путь 1: по именам
    for _, x in ipairs(m:GetDescendants()) do
        if x:IsA("BasePart") then
            local n = x.Name:lower()
            if n:find("prop") or n:find("blade") or n:find("rotor")
                or n:find("винт") or n:find("лопаст") or n:find("fan") then
                found[#found + 1] = x
            end
        end
    end

    local okB, bbCF, bbSize = pcall(function() return m:GetBoundingBox() end)

    -- путь 2: авто — плоские детали вдали от центра
    if #found == 0 and okB and bbCF then
        local c = bbCF.Position
        local ext = math.max(bbSize.X, bbSize.Y, bbSize.Z)
        local biggest, bigVol = nil, 0
        for _, x in ipairs(m:GetDescendants()) do
            if x:IsA("BasePart") and x.Transparency < 1 then
                local v = x.Size.X * x.Size.Y * x.Size.Z
                if v > bigVol then bigVol = v biggest = x end
            end
        end
        local cands = {}
        for _, x in ipairs(m:GetDescendants()) do
            if x:IsA("BasePart") and x.Transparency < 1 and x ~= biggest then
                local dims = { x.Size.X, x.Size.Y, x.Size.Z }
                table.sort(dims)
                local isFlat = dims[1] < dims[3] * 0.4
                local flatDist = (Vector3.new(x.Position.X, 0, x.Position.Z)
                    - Vector3.new(c.X, 0, c.Z)).Magnitude
                if isFlat and flatDist > ext * 0.12 then
                    cands[#cands + 1] = { p = x, d = flatDist }
                end
            end
        end
        table.sort(cands, function(a, b) return a.d > b.d end)
        for i = 1, math.min(#cands, 4) do
            found[#found + 1] = cands[i].p
        end
    end

    -- путь 3: вообще ничего — 4 эффекта по углам корпуса
    if #found == 0 then
        if not okB or not bbCF then return {} end
        local rel = pivotCF:ToObjectSpace(bbCF)
        local c = rel.Position
        local hx = math.max(bbSize.X, 0.5) / 2
        local hz = math.max(bbSize.Z, 0.5) / 2
        local hy = bbSize.Y / 2
        local k = CONFIG.HUB_K
        local R = math.max(k * math.min(hx, hz) * CONFIG.HUB_DK, 0.7)
        local hubs = {}
        for _, sx in ipairs({1, -1}) do
            for _, sz in ipairs({1, -1}) do
                hubs[#hubs + 1] = {
                    hub = Vector3.new(c.X + hx * k * sx, c.Y + hy * CONFIG.HUB_Y, c.Z + hz * k * sz),
                    R = R,
                }
            end
        end
        print("[ШАХЕД HUB] FPV: лопасти не найдены — эффекты по 4 углам: " .. #hubs)
        return hubs
    end

    -- группировка лопастей по втулкам
    local items = {}
    for _, x in ipairs(found) do
        items[#items + 1] = { p = x, cf = pivotCF:ToObjectSpace(x.CFrame) }
    end
    print("[ШАХЕД HUB] FPV: лопастей найдено: " .. #items)

    local ext = okB and math.max(bbSize.X, bbSize.Y, bbSize.Z) or 10
    local Rg = math.max(ext * 0.15, 0.8)

    local function buildGroups(radius)
        local gs = {}
        for _, it in ipairs(items) do
            local best, bestD = nil, math.huge
            for _, g in ipairs(gs) do
                local d = (g.hub - it.cf.Position).Magnitude
                if d < bestD then bestD = d best = g end
            end
            if best and bestD <= radius then
                best.parts[#best.parts + 1] = it
            else
                gs[#gs + 1] = { hub = it.cf.Position, parts = { it } }
            end
        end
        return gs
    end

    local groups = buildGroups(Rg)
    if #groups == 1 and #items >= 2 then
        groups = buildGroups(Rg * 0.4)
    end

    local hubs = {}
    for _, g in ipairs(groups) do
        local sum = Vector3.zero
        for _, it in ipairs(g.parts) do sum = sum + it.cf.Position end
        local hub = sum / #g.parts
        local maxR = 0.5
        for _, it in ipairs(g.parts) do
            local cf, s = it.cf, it.p.Size
            for ox = -1, 1, 2 do
                for oy = -1, 1, 2 do
                    for oz = -1, 1, 2 do
                        local c3 = (cf * CFrame.new(s.X * 0.5 * ox, s.Y * 0.5 * oy, s.Z * 0.5 * oz)).Position
                        maxR = math.max(maxR, (c3 - hub).Magnitude)
                    end
                end
            end
        end
        hubs[#hubs + 1] = { hub = hub, R = maxR }
    end
    print("[ШАХЕД HUB] FPV: втулок: " .. #hubs)
    return hubs
end

