local win, winScale, menuBtn
local tooltip, tooltipTween
local menuOpen = false
local menuTween = nil
local tooltipToken = 0

local function hideTooltip()
    tooltipToken += 1
    if not (tooltip and tooltip.Visible) then return end
    if tooltipTween then tooltipTween:Cancel() end
    tooltipTween = tw(tooltip, 0.12, { BackgroundTransparency = 1, TextTransparency = 1 })
    tooltipTween.Completed:Once(function()
        tooltip.Visible = false
    end)
end

local function showTooltip()
    if menuOpen or not tooltip then return end
    tooltipToken += 1
    local my = tooltipToken
    if tooltipTween then tooltipTween:Cancel() end
    tooltip.BackgroundTransparency = 1
    tooltip.TextTransparency = 1
    tooltip.Visible = true
    tooltipTween = tw(tooltip, 0.12, { BackgroundTransparency = 0.05, TextTransparency = 0 })
    task.delay(1.6, function()
        if tooltipToken ~= my then return end
        if tooltip and tooltip.Visible then
            tooltipTween = tw(tooltip, 0.2, { BackgroundTransparency = 1, TextTransparency = 1 })
            tooltipTween.Completed:Once(function()
                tooltip.Visible = false
            end)
        end
    end)
end

local function setMenuOpen(open)
    menuOpen = open
    if open then hideTooltip() end
    if win then
        if menuTween then menuTween:Cancel() menuTween = nil end
        if open then
            win.Visible = true
            winScale.Scale = 0.9
            win.GroupTransparency = 1
            menuTween = tw(win, 0.22, { GroupTransparency = 0 })
            tw(winScale, 0.22, { Scale = 1 })
        else
            menuTween = tw(win, 0.15, { GroupTransparency = 1 })
            tw(winScale, 0.15, { Scale = 0.9 })
            menuTween.Completed:Once(function()
                if not menuOpen then win.Visible = false end
            end)
        end
    end
    if menuBtn then
        menuBtn.Text = open and "ЗАКРЫТЬ" or "МЕНЮ"
    end
end

toggleWindow = function(force)
    setMenuOpen(force == nil and (not menuOpen) or force)
end

