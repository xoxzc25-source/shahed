local function makeCrater(res, tp)
    if not res then return end
    local k = (tp == "fpv") and 0.6 or 1
    local n = res.Normal
    local center = res.Position
    local inst = res.Instance
    local mat = res.Material
    local color = Color3.fromRGB(110, 100, 90)
    if inst and inst:IsA("Terrain") then
        local ok, c = pcall(function() return inst:GetMaterialColor(res.Material) end)
        if ok and c then color = c end
    elseif inst and inst:IsA("BasePart") then
        color = inst.Color
    end
    if mat == Enum.Material.Glass or mat == Enum.Material.ForceField or mat == Enum.Material.Neon
        or mat == Enum.Material.Air or mat == Enum.Material.Water then
        mat = Enum.Material.Slate
    end

    local axis = (math.abs(n.Y) > 0.99) and Vector3.xAxis or Vector3.yAxis
    local right = axis:Cross(n).Unit
    local basis = CFrame.fromMatrix(center, right, n)

    local folder = Instance.new("Folder")
    folder.Name = "ShahedCrater"
    folder.Parent = workspace
    local blocks = {}

    local function shade(f) return color:Lerp(Color3.new(0, 0, 0), f) end
    local function block(size, lp, rotY, tx, tz, col)
        local p = Instance.new("Part")
        p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
        p.Material = mat
        p.Color = col
        p.Size = size
        p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
        p.CFrame = basis * CFrame.new(0, 0.3, 0) * CFrame.Angles(0, rotY, 0)
