local function samplePath(path, t)
    if #path == 0 then return nil end
    if t <= path[1].t then return path[1].cf end
    local last = path[#path]
    if t >= last.t then return last.cf end
    for i = 1, #path - 1 do
        local a, b = path[i], path[i + 1]
        if t >= a.t and t <= b.t then
            local k = (t - a.t) / math.max(b.t - a.t, 1e-6)
            return a.cf:Lerp(b.cf, k)
        end
    end
    return last.cf
end

-- Человек на повторе: клон целого персонажа (одежда/лицо/цвет)
local function buildPersonForReplay(targetChar, rootCF)
    if not targetChar then return nil end
    local ok, m = pcall(function()
        targetChar.Archivable = true
        local clone = targetChar:Clone()
        if not clone then return nil end
        for _, x in ipairs(clone:GetDescendants()) do
            if x:IsA("Script") or x:IsA("LocalScript") or x:IsA("Sound")
                or x:IsA("ParticleEmitter") or x:IsA("Fire") or x:IsA("Smoke")
                or x:IsA("Sparkles") or x:IsA("BillboardGui") then
                x:Destroy()
            elseif x:IsA("BasePart") then
                x.Anchored, x.CanCollide, x.CanQuery, x.CanTouch = true, false, false, false
            end
        end
        local hum = clone:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        end
        local hroot = clone:FindFirstChild("HumanoidRootPart")
        if hroot then clone.PrimaryPart = hroot end
        clone:PivotTo(rootCF)
        return clone
    end)
    if ok and m and m:FindFirstChildWhichIsA("BasePart", true) then
        return m
    end
    return nil
end

