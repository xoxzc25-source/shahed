        boostB.TextColor3 = touchState.boost and T.black or T.white
    end)
    camB.Activated:Connect(function() firstPerson = not firstPerson end)
    recB.Activated:Connect(function() if flying then endFlight(false) end end)
    boomB.Activated:Connect(function()
        if flying and os.clock() - flightStart > CONFIG.DRONE_MIN then endFlight(true) end
    end)

    setTouchVisible = function(v)
        tgui.Visible = v
        lookInput = nil
        resetStick()
        touchState.look = Vector2.zero
        touchState.up, touchState.down, touchState.boost = false, false, false
        boostB.BackgroundColor3 = T.panel
        boostB.TextColor3 = T.white
        upB.BackgroundTransparency = 0.3
        downB.BackgroundTransparency = 0.3
    end
end

local function launchDrone()
    if flying then return end
    local char = getChar()
    local hum, r = getHum(), getRoot()
    if not (hum and r and hum.Health > 0) then return end
    local isFpv = (droneType == "fpv")

    local okModel, model = pcall(makeDroneModel, droneType)
    if not okModel or not model or not anyPart(model) then
        setStatus("модель не загрузилась")
        warn("[ШАХЕД HUB] модель дрона не построилась, запуск отменён")
        return
    end

    recBuf = {}
    recPlayers = {}

    flying = true
    savedWS, savedJP = hum.WalkSpeed, hum.JumpPower
    hum.WalkSpeed, hum.JumpPower = 0, 0
    pcall(function() controls:Disable() end)
    if CONFIG.HIDE_CHAR then hideChar(true) end
    if CONFIG.FREEZE_CHAR then
        r.Anchored = true
    end
    if toggleWindow then toggleWindow(false) end
    if not IS_MOBILE then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    end

    droneModel = model
    droneModel.Parent = workspace
    droneParts = {}
    fpApplied = false
    for _, dp in ipairs(droneModel:GetDescendants()) do
        if dp:IsA("BasePart") then droneParts[#droneParts + 1] = dp end
    end

    --═══ НАСТРОЙКА УПРАВЛЕНИЯ ═══
    local spd, boost, vert, lerpK, camOff, backSpd, strafe, yawK, rollK, sens, pMin, pMax, engineBase0, engineVol
    if isFpv then
        spd = 95
        boost = 160
        vert = 42
        lerpK = 6.5
        camOff = CFrame.new(0, CONFIG.CAM_FPV_Y, CONFIG.CAM_FPV_D)
        backSpd = 35
        strafe = CONFIG.STRAFE
        yawK = 2.8
        rollK = 0.28
        sens = 0.0045
        pMin = -1.5
        pMax = 1.45
        engineBase0 = 1
        engineVol = 0.95
    else
        spd = 60
        boost = 110
        vert = 28
        lerpK = 4
        camOff = CFrame.new(0, CONFIG.CAM_SH_Y, CONFIG.CAM_SH_D)
        backSpd = 0
        strafe = 0
        yawK = 1.8
        rollK = 0.3
        sens = 0.0035
        pMin = -1.45
        pMax = 1.3
        engineBase0 = 1
        engineVol = 1.1
    end

    local fpCamOff = isFpv and CFrame.new(0, 0.15, -2.2) or CFrame.new(0, 0.3, -5.5)
    local cam0 = workspace.CurrentCamera
    local look = cam0 and cam0.CFrame.LookVector or Vector3.new(0, 0, -1)
    yaw = math.atan2(-look.X, -look.Z)
    pitch, roll, vel, spin = 0, 0, Vector3.zero, 0
    firstPerson = false
    flightStart = os.clock()
    dronePos = r.Position + Vector3.new(0, isFpv and 2 or 3, 0)

    local pivot0 = CFrame.new(dronePos) * CFrame.fromEulerAnglesYXZ(0, yaw, 0)
    droneModel:PivotTo(pivot0)

    if cam0 then
        cam0.CameraType = Enum.CameraType.Scriptable
        local eye = (pivot0 * camOff).Position
        cam0.CFrame = CFrame.lookAt(eye, eye + pivot0.LookVector)
    end

    -- ШАХЕД: v5.2 логика • FPV: эффекты вращения (лопасти не трогаем)
    propLocals = {}
    fpvFX = {}
    if isFpv then
        fpvFX = createFpvSpinFX(droneModel, collectFpvHubs(droneModel, pivot0))
        for _, g in ipairs(fpvFX) do
            for _, mem in ipairs(g.parts) do
                droneParts[#droneParts + 1] = mem.p
            end
        end
    else
        propLocals = collectPropLocals(droneModel, false, pivot0)
    end

    local engId = pickSound(isFpv and "engine_fpv" or "engine_shahed")
    if engId then
        engineSound = makeSound(engId, SoundService, true, engineVol)
        engineBase = engineBase0
    else
        engineSound = makeSound(SND_ENGINE, SoundService, true, engineVol)
        engineBase = isFpv and 1.2 or 0.9
    end
    if engineSound then
        engineSound.PlaybackSpeed = engineBase
        engineSound:Play()
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { droneModel, char }

    setStatus("DRONE ACTIVE")
    setButtons(false, true, true)
    if hintLbl then hintLbl.Visible = not IS_MOBILE end
    if osd then osd.Visible = true end
    setTouchVisible(true)
    local lastYaw = yaw

    RunService:BindToRenderStep(CAM_BIND, Enum.RenderPriority.Camera.Value + 1, function(dt)
        local hum2 = getHum()
        if not (droneModel and hum2 and hum2.Health > 0) then endFlight(false) return end

        local cam = workspace.CurrentCamera
        if not cam then return end
        if cam.CameraType ~= Enum.CameraType.Scriptable then
            cam.CameraType = Enum.CameraType.Scriptable
        end
        if not IS_MOBILE and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        end

        local md = UserInputService:GetMouseDelta()
        if IS_MOBILE then
            md = md + touchState.look * 1.3
            touchState.look = Vector2.zero
        end
        yaw -= md.X * sens
        pitch = math.clamp(pitch - md.Y * sens, pMin, pMax)

        local rightV = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))

        if not isFpv then
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then yaw += yawK * dt end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then yaw -= yawK * dt end
            if IS_MOBILE then yaw -= touchState.mv.X * yawK * dt end
        end

        local lookV = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0).LookVector
        local flat = Vector3.new(lookV.X, 0, lookV.Z)
        if flat.Magnitude > 0.001 then flat = flat.Unit else flat = Vector3.zero end

        local ms = touchState.mv
        local boosting = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or touchState.boost
        local fwdAxis, backAxis, strafeAxis, upAxis = 0, 0, 0, 0
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then fwdAxis = 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then backAxis = 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then strafeAxis += 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then strafeAxis -= 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then upAxis += 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then upAxis -= 1 end
        if IS_MOBILE then
            fwdAxis = math.max(fwdAxis, math.clamp(ms.Y * 1.25, 0, 1))
            backAxis = math.max(backAxis, math.clamp(-ms.Y * 1.25, 0, 1))
            strafeAxis = math.clamp(strafeAxis + ms.X, -1, 1)
            if touchState.up then upAxis += 1 end
            if touchState.down then upAxis -= 1 end
        end
        local tv = Vector3.zero
        if fwdAxis > 0 then tv = tv + lookV * ((boosting and boost or spd) * fwdAxis) end
        -- НАЗАД = по обратному взгляду: камера вниз + S = назад-вверх
        if backSpd > 0 and backAxis > 0 then tv = tv - lookV * (backSpd * backAxis) end
        if strafe > 0 and strafeAxis ~= 0 then tv = tv + rightV * (strafe * strafeAxis) end
        if upAxis ~= 0 then tv = tv + Vector3.new(0, vert * upAxis, 0) end
        vel = vel:Lerp(tv, math.clamp(dt * lerpK, 0, 1))
        local move = vel * dt
        if move.Magnitude > 0 then
            local hit = workspace:Spherecast(dronePos, 1.2, move, params)
            if hit then
                local dd = move:Dot(hit.Normal)
                if dd < 0 then move = move - hit.Normal * dd end
            end
            dronePos = dronePos + move
        end

        for _, o in ipairs(Players:GetPlayers()) do
            if o ~= player and o.Character then
                local hr = o.Character:FindFirstChild("HumanoidRootPart")
                local oh = o.Character:FindFirstChildOfClass("Humanoid")
                if hr and oh and oh.Health > 0 and (hr.Position - dronePos).Magnitude < CONFIG.COLLIDE_DIST then
                    endFlight(true)
                    return
                end
            end
        end

        local yawRate = (yaw - lastYaw) / math.max(dt, 1/240)
        lastYaw = yaw
        local rollTarget
        if isFpv then
            rollTarget = math.clamp(-vel:Dot(rightV) * rollK * 0.02, -0.3, 0.3)
        else
            rollTarget = math.clamp(yawRate * rollK, -0.5, 0.5)
        end
        roll = roll + (rollTarget - roll) * math.clamp(dt * 7, 0, 1)

        local pivot = CFrame.new(dronePos) * CFrame.fromEulerAnglesYXZ(pitch, yaw, roll)
        droneModel:PivotTo(pivot)

        -- винты: FPV — эффекты (лопасти статичны), ШАХЕД — v5.2
        if isFpv then
            spin = spin + dt * 22
            updateFpvFX(fpvFX, pivot, spin)
        else
            spin = spin + dt * 40
            for _, pr in ipairs(propLocals) do
                if pr.p.Parent then
                    local sp
                    if pr.axisRel then
                        sp = pr.rel.Rotation * CFrame.fromAxisAngle(pr.axisRel, spin)
                    elseif pr.ax == "y" then
                        sp = pr.rel.Rotation * CFrame.Angles(0, spin, 0)
                    else
                        sp = pr.rel.Rotation * CFrame.Angles(0, 0, spin)
                    end
                    pr.p.CFrame = pivot * CFrame.new(pr.rel.Position) * sp
                end
            end
        end

        if firstPerson ~= fpApplied then
            fpApplied = firstPerson
            for _, dp in ipairs(droneParts) do
                if dp.Parent then dp.LocalTransparencyModifier = fpApplied and 1 or 0 end
            end
        end
        local camT
        if firstPerson then
            camT = pivot * fpCamOff
        else
            local eye = (pivot * camOff).Position
            camT = CFrame.lookAt(eye, eye + pivot.LookVector)
        end
        cam.CFrame = camT

        local nowT = os.clock()
        recBuf[#recBuf + 1] = { t = nowT, cf = pivot }
        while #recBuf > 2 and nowT - recBuf[1].t > CONFIG.REC_LEN do table.remove(recBuf, 1) end
        for _, o in ipairs(Players:GetPlayers()) do
            if o ~= player and o.Character then
                local hr = o.Character:FindFirstChild("HumanoidRootPart")
                if hr and hr.Parent then
                    local arr = recPlayers[o]
                    if not arr then arr = {} recPlayers[o] = arr end
                    arr[#arr + 1] = { t = nowT, cf = hr.CFrame }
                    while #arr > 2 and nowT - arr[1].t > CONFIG.REC_LEN do table.remove(arr, 1) end
                end
            end
        end

        local bat = math.max(8, 98 - math.floor((os.clock() - flightStart) / 8))
        osdLBox.Text = string.format("SPD %03d\nFPS %d", math.floor(vel.Magnitude + 0.5), state.fps)
        osdRBox.Text = string.format("ALT %d\nBAT %d%%", math.floor(dronePos.Y + 0.5), bat)
        batLbl.Text = string.format("BAT %d%%", bat)
        recDot.Visible = (os.clock() % 1) < 0.55
        if engineSound then
            pcall(function() engineSound.PlaybackSpeed = engineBase + vel.Magnitude / 400 end)
        end
    end)
end

